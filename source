        return "Roblox"
    except Exception as e:
        print(f"Failed to auto-install Roblox: {e}\n")
        return None

def parse_version(tag):
    if not tag:
        return (0, 0, 0)
    clean = ''.join(c for c in tag if c.isdigit() or c == '.')
    parts = []
    for p in clean.split('.'):
        if p.isdigit():
            parts.append(int(p))
    while len(parts) < 3:
        parts.append(0)
    return tuple(parts[:3])

def auto_install_github_release(repo, name, is_prerelease=False):
    display_name = f"{name} Pre-Release" if is_prerelease else name
    print(f"{GREEN}[+] Automatically downloading and launching {display_name}...{RESET}")
    
    try:
        if is_prerelease:
            api_url = f"https://api.github.com/repos/{repo}/releases"
        else:
            api_url = f"https://api.github.com/repos/{repo}/releases/latest"
            
        req = urllib.request.Request(api_url, headers={'User-Agent': 'Mozilla/5.0'})
        
        try:
            with urllib.request.urlopen(req) as response:
                data = json.loads(response.read().decode())
        except urllib.error.HTTPError as err:
            if err.code == 404 and not is_prerelease:
                api_url = f"https://api.github.com/repos/{repo}/releases"
                req = urllib.request.Request(api_url, headers={'User-Agent': 'Mozilla/5.0'})
                with urllib.request.urlopen(req) as response:
                    data = json.loads(response.read().decode())
            else:
                raise err
        
        target_release = None
        if is_prerelease or isinstance(data, list):
            if isinstance(data, list):
                if is_prerelease:
                    for rel in data:
                        if rel.get("prerelease", False):
                            target_release = rel
                            break
                    if not target_release and len(data) > 0:
                        target_release = data[0]
                else:
                    if len(data) > 0:
                        target_release = data[0]
            if not target_release:
                raise Exception(f"No releases found for {name}.")
        else:
            target_release = data

        tag = target_release.get("tag_name", "") or target_release.get("name", "")
        version = parse_version(tag)
        
        target_ext = ".exe"
        if name.lower() == "froststrap" and version >= (2, 0, 4):
            target_ext = ".msi"

        installer_path = Path(os.getenv('TEMP')) / f"{name}{target_ext}"

        download_url = None
        for asset in target_release.get("assets", []):
            if asset["name"].endswith(target_ext):
                download_url = asset["browser_download_url"]
                break
        
        if not download_url and target_ext == ".msi":
            for asset in target_release.get("assets", []):
                if asset["name"].endswith(".exe"):
                    download_url = asset["browser_download_url"]
                    target_ext = ".exe"
                    installer_path = Path(os.getenv('TEMP')) / f"{name}{target_ext}"
                    break

        if not download_url:
            raise Exception(f"No executable asset found in {display_name} release.")

        dl_req = urllib.request.Request(download_url, headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(dl_req) as response, open(installer_path, 'wb') as out_file:
            out_file.write(response.read())

        if target_ext == ".msi":
            subprocess.Popen(["msiexec", "/i", str(installer_path)])
        else:
            subprocess.Popen([str(installer_path)])
            
        print(f"{GREEN}SUCCESS: {display_name} installer launched!{RESET}\n")
        return display_name
    except Exception as e:
        print(f"Failed to auto-install {display_name}: {e}\n")
        return None

def prompt_reinstall():
    print("[+] Installation Options:")
    print(f"{GREEN}1. Roblox (Standard Bootstrapper){RESET}")
    print(f"{GREEN}2. Froststrap{RESET}")
    print(f"{GREEN}3. Froststrap Pre-Release{RESET}")
    print(f"{GREEN}4. Bloxstrap{RESET}")
    print(f"{GREEN}5. Voidstrap{RESET}")
    print(f"{GREEN}6. Bubblestrap{RESET}")
    print("")
    choice = input("Select an option (1-6): ").strip()
    print("")
    
    installed = None
    if choice == "1":
        installed = auto_install_roblox()
    elif choice == "2":
        installed = auto_install_github_release("Froststrap/Froststrap", "Froststrap")
    elif choice == "3":
        installed = auto_install_github_release("Froststrap/Froststrap", "Froststrap", is_prerelease=True)
    elif choice == "4":
        installed = auto_install_github_release("bloxstraplabs/bloxstrap", "Bloxstrap")
    elif choice == "5":
        installed = auto_install_github_release("KloBraticc/Voidstrap", "Voidstrap")
    elif choice == "6":
        installed = auto_install_github_release("ItzBloxxy/Bubblestrap", "Bubblestrap")
    else:
        print("Error: Invalid option selected.\n")
        return False
    print("")

    if installed:
        write_log([installed], action="Installed")
    return True

def handle_install_command(arg):
    if not arg:
        return prompt_reinstall()
    
    arg_lower = arg.lower()
    
    install_options = [
        {"name": "Roblox (Standard Bootstrapper)", "key": "roblox", "func": auto_install_roblox},
        {"name": "Froststrap", "key": "froststrap", "func": lambda: auto_install_github_release("Froststrap/Froststrap", "Froststrap")},
        {"name": "Froststrap Pre-Release", "key": "prerelease", "func": lambda: auto_install_github_release("Froststrap/Froststrap", "Froststrap", is_prerelease=True)},
        {"name": "Bloxstrap", "key": "bloxstrap", "func": lambda: auto_install_github_release("bloxstraplabs/bloxstrap", "Bloxstrap")},
        {"name": "Voidstrap", "key": "voidstrap", "func": lambda: auto_install_github_release("KloBraticc/Voidstrap", "Voidstrap")},
        {"name": "Bubblestrap", "key": "bubblestrap", "func": lambda: auto_install_github_release("ItzBloxxy/Bubblestrap", "Bubblestrap")},
    ]
    
    matches = []
    for opt in install_options:
        if arg_lower in opt["name"].lower() or arg_lower in opt["key"]:
            matches.append(opt)
            
    if not matches:
        print(f"No matching installer found for '{arg}'. Showing installation options:\n")
        return prompt_reinstall()
    elif len(matches) == 1:
        chosen = matches[0]
        installed = chosen["func"]()
        if installed:
            write_log([installed], action="Installed")
        return True
    else:
        print(f"[+] Multiple matches found for '{arg}':")
        for idx, match in enumerate(matches, 1):
            print(f"{GREEN}{idx}. {match['name']}{RESET}")
        print("")
        choice_input = input(f"Select an option (1-{len(matches)}): ").strip()
        print("")
        if not choice_input.isdigit() or not (1 <= int(choice_input) <= len(matches)):
            print("Invalid selection.\n")
            return False
        chosen = matches[int(choice_input) - 1]
        installed = chosen["func"]()
        if installed:
            write_log([installed], action="Installed")
        return True

def handle_uninstall_command(arg):
    if not arg:
        uninstall_single_bootstrapper()
        return
    
    arg_lower = arg.lower()
    potential_targets = ["Roblox", "Fishstrap", "Bloxstrap", "Voidstrap", "Froststrap", "Plexity", "Bubblestrap"]
    matched = None
    for target in potential_targets:
        if arg_lower in target.lower():
            matched = target
            break
            
    if not matched:
        print(f"No matching bootstrapper found for '{arg}'.\n")
        uninstall_single_bootstrapper()
        return
        
    confirm = input(f"This will uninstall {matched}, are you sure you want to proceed? (y/n): ").strip().lower()
    if confirm in ["y", "yes"]:
        cleaned_folders = force_cleanup(specific_target=matched)
        write_log(cleaned_folders, action="Cleaned")
        print("------------------------------------------")
        print("Operation Complete.")
        print("------------------------------------------\n")
    else:
        print("Operation cancelled.\n")

def show_help():
