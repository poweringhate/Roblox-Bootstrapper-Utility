    def print_line(left_colored, left_plain, desc):
        target_width = 16
        padding = max(0, target_width - len(left_plain))
        print(f"  {left_colored}{' ' * padding} - {desc}")

    print_line(f"{CYAN}help{RESET}", "help", "Display all available commands and detailed usage")
    print_line(f"{CYAN}install{RESET} {YELLOW}<name>{RESET}", "install <name>", "Present interactive installation menu or instantly install a specific bootstrapper by name")
    print_line(f"{CYAN}uninstall{RESET} {YELLOW}<name>{RESET}", "uninstall <name>", "Present interactive uninstallation menu or instantly uninstall a specific bootstrapper by name")
    print_line(f"{CYAN}apps{RESET}", "apps", "Present all installed installations for Roblox and other bootstrappers")
    print_line(f"{CYAN}purge{RESET}", "purge", "Completely uninstall Roblox, all custom bootstrappers, registry keys, and residual files")
    print("")

