def force_cleanup(specific_target=None):
    print("Cleaning...")
    
    targets = [specific_target] if specific_target else ["Roblox", "Fishstrap", "Bloxstrap", "Voidstrap", "Froststrap", "Plexity", "Bubblestrap"]
    paths = [os.getenv('LOCALAPPDATA'), os.getenv('TEMP'), os.getenv('PROGRAMFILES'), os.getenv('PROGRAMFILES(X86)')]
    
    deleted_targets = set()
    
    apps_map = {
        "Roblox": ["RobloxPlayerBeta.exe", "RobloxPlayerLauncher.exe", "Roblox.exe"],
        "Fishstrap": ["Fishstrap.exe"],
        "Bloxstrap": ["Bloxstrap.exe"],
        "Voidstrap": ["Voidstrap.exe"],
        "Froststrap": ["Froststrap.exe"],
        "Plexity": ["Plexity.exe"],
        "Bubblestrap": ["Bubblestrap.exe"]
    }
    
    apps = []
    if specific_target:
        apps = apps_map.get(specific_target, [f"{specific_target}.exe"])
    else:
        for app_list in apps_map.values():
            apps.extend(app_list)
    
    for app in apps:
        subprocess.run(f'taskkill /F /IM "{app}" /T', capture_output=True, shell=True)
    
    time.sleep(1)

    for p in paths:
        if not p: continue
        for target in targets:
            folder = Path(p) / target
            if folder.exists():
                subprocess.run(["powershell", "-Command", f"Remove-Item -Recurse -Force '{folder}' -ErrorAction SilentlyContinue"], capture_output=True)
                if not folder.exists():
                    deleted_targets.add(target)

    # Silent MSI uninstallation, registry cleanup, and elevated folder purge for Froststrap in Program Files
    if not specific_target or specific_target == "Froststrap":
        subprocess.run(["powershell", "-Command", "Get-CimInstance Win32_Product | Where-Object {$_.Name -like '*Froststrap*'} | Invoke-CimMethod -MethodName Uninstall -ErrorAction SilentlyContinue"], capture_output=True)
        
        ps_script = (
            "$uninstallKeys = @('HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*', 'HKLM:\\Software\\Wow6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*', 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*'); "
            "foreach ($key in $uninstallKeys) { "
            "   Get-ItemProperty $key -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -like '*Froststrap*' } | ForEach-Object { "
            "       if ($_.UninstallString) { "
            "           $uninst = $_.UninstallString; "
            "           if ($uninst -match 'MsiExec.exe') { "
            "               $uninst = $uninst -replace '/I','/X' + ' /qn /norestart'; "
            "               Start-Process cmd -ArgumentList '/c $uninst' -Wait -WindowStyle Hidden -ErrorAction SilentlyContinue; "
            "           } "
            "       } "
            "   } "
            "}"
        )
        subprocess.run(["powershell", "-Command", ps_script], capture_output=True)

        for pf in [os.getenv('PROGRAMFILES'), os.getenv('PROGRAMFILES(X86)')]:
            if pf:
                f_folder = Path(pf) / "Froststrap"
                if f_folder.exists():
                    subprocess.run(["powershell", "-Command", f"Remove-Item -Recurse -Force '{f_folder}' -ErrorAction SilentlyContinue"], capture_output=True)
                    if f_folder.exists():
                        subprocess.run(["powershell", "-Command", f"Start-Process powershell -ArgumentList '-Command \"Remove-Item -Recurse -Force \\\"{f_folder}\\\" -ErrorAction SilentlyContinue\"' -Verb RunAs -Wait"], capture_output=True)
                    if not f_folder.exists():
                        deleted_targets.add("Froststrap")

    # Registry Cleanup for Roblox, Froststrap, and Voidstrap (Silent)
    if not specific_target or specific_target in ["Roblox", "Froststrap", "Voidstrap"]:
        reg_keys = []
        if not specific_target or specific_target == "Roblox":
            reg_keys.extend([
                r"HKCU\Software\ROBLOX Corporation",
                r"HKCU\Software\Roblox",
                r"HKCU\Software\Classes\roblox",
                r"HKCU\Software\Classes\roblox-player",
                r"HKCU\Software\Classes\roblox-studio",
                r"HKCU\Software\Classes\roblox-studio-auth"
            ])
        if not specific_target or specific_target == "Froststrap":
            reg_keys.append(r"HKCU\Software\Froststrap")
        if not specific_target or specific_target == "Voidstrap":
            reg_keys.append(r"HKCU\Software\Voidstrap")

        for key in reg_keys:
            subprocess.run(f'reg delete "{key}" /f', capture_output=True, shell=True)

    for item in deleted_targets:
        print(f"{GREEN}SUCCESS: Removed {item}{RESET}")
    
    print("") 
    return list(deleted_targets)

def uninstall_single_bootstrapper():
    potential_targets = ["Roblox", "Fishstrap", "Bloxstrap", "Voidstrap", "Froststrap", "Plexity", "Bubblestrap"]
    paths = [os.getenv('LOCALAPPDATA'), os.getenv('TEMP'), os.getenv('PROGRAMFILES'), os.getenv('PROGRAMFILES(X86)')]
    
    installed = []
    for target in potential_targets:
        found = False
        for p in paths:
            if not p: continue
            folder = Path(p) / target
            if folder.exists():
                found = True
                break
        if not found and target == "Froststrap":
            for pf in [os.getenv('PROGRAMFILES'), os.getenv('PROGRAMFILES(X86)')]:
                if pf and (Path(pf) / "Froststrap").exists():
                    found = True
                    break
        if found and target not in installed:
            installed.append(target)
            
    if not installed:
        print("No installed Roblox or bootstrappers found.\n")
        return
        
    print("[+] Installed Roblox / Bootstrappers:")
    for idx, item in enumerate(installed, 1):
        print(f"{GREEN}{idx}. {item}{RESET}")
    print("")
    
    choice_input = input(f"Select a bootstrapper to uninstall (1-{len(installed)}): ").strip()
    print("")
    
    if not choice_input.isdigit() or not (1 <= int(choice_input) <= len(installed)):
        print("Invalid selection.\n")
        return
        
    chosen_target = installed[int(choice_input) - 1]
    
    confirm = input(f"This will uninstall {chosen_target}, are you sure you want to proceed? (y/n): ").strip().lower()
    if confirm in ["y", "yes"]:
        cleaned_folders = force_cleanup(specific_target=chosen_target)
        write_log(cleaned_folders, action="Cleaned")
        print("------------------------------------------")
        print("Operation Complete.")
        print("------------------------------------------\n")
    else:
        print("Operation cancelled.\n")

